{
  "name": "dsh-notify-interactive",
  "version": "0.3.0",
  "description": "Native Windows Notification Center reminders and explicit replies for DSH Web.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "scripts/uninstall-windows.mjs"
  ],
  "license": "MIT",
  "author": "wuqiuwangtian",
  "homepage": "https://github.com/wuqiuwangtian/dsh-notify-interactive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuqiuwangtian/dsh-notify-interactive.git"
  },
  "bugs": {
    "url": "https://github.com/wuqiuwangtian/dsh-notify-interactive/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "popup",
    "approval",
    "ask-user"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-shell",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check scripts/uninstall-windows.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm build && pnpm check && pnpm test && pnpm render-smoke",
    "render-smoke": "node scripts/render-smoke.mjs",
    "native:acceptance": "pnpm build && node scripts/native-acceptance.mjs",
    "windows:uninstall": "node scripts/uninstall-windows.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
